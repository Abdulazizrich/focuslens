[[9,[{"type":"replace_text","element_id":"PB1TT5K1HH4jS3Vk-LB6SDDQDJ4c25rz8","text":"Ixtiyoriy AI yordamchisi foydalanuvchi savolini va umumiy sessiya ko‘rsatkichlarini sodda tavsiyalarga aylantiradi. U vazifani kichik bosqichlarga ajratish, ish va dam olish rejasini tuzish yoki kunlik xulosani tushuntirish uchun qo‘llanadi."},{"type":"position_element","element_id":"PB1TT5K1HH4jS3Vk-LB6SDDQDJ4c25rz8","left":108,"top":220},{"type":"resize_element","element_id":"PB1TT5K1HH4jS3Vk-LB6SDDQDJ4c25rz8","width":1680},{"type":"format_text","element_id":"PB1TT5K1HH4jS3Vk-LB6SDDQDJ4c25rz8","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PB1TT5K1HH4jS3Vk-LB1x5YPSKnbZYwXC","text":"DeepSeek API orqali yuboriladigan so‘rov ixtiyoriy. API foydalanishga qarab haq oladi; kelajakdagi pullik tariflarda AI limiti va xizmat xarajati hisobga olinadi."},{"type":"position_element","element_id":"PB1TT5K1HH4jS3Vk-LB1x5YPSKnbZYwXC","left":1320,"top":410},{"type":"resize_element","element_id":"PB1TT5K1HH4jS3Vk-LB1x5YPSKnbZYwXC","width":470},{"type":"format_text","element_id":"PB1TT5K1HH4jS3Vk-LB1x5YPSKnbZYwXC","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}},{"type":"position_element","element_id":"PB1TT5K1HH4jS3Vk-LBQ32q421WJ4Mlxf","left":1320,"top":875}]],[10,[{"type":"replace_text","element_id":"PBq6H70nRkMfD5Xj-LBmmGM4RXlN9J24R","text":"REJALASHTIRILGAN MODUL. Kamera orqali bosh va yelkaning shaxsiy boshlang‘ich holatdan uzoq davom etgan og‘ishini kuzatish rejalashtirilgan. Bir lahzalik harakat sabab ogohlantirish berilmaydi; takroriy eslatmalar cheklanadi.\nMisol: «Holatingizni o‘zgartirib, yelkalarni bo‘shashtirib ko‘ring». Maqsad foydalanuvchiga holatini va tanaffusni eslatishdir.\nKamera joylashuvi barcha tana qismlarini ko‘rsatmasligi mumkin. Modul ergonomik odatlarni qo‘llab-quvvatlaydi, tibbiy tashxis bermaydi. Umumiy ergonomik asos: OSHA kompyuter ish joyi tavsiyalari."},{"type":"position_element","element_id":"PBq6H70nRkMfD5Xj-LBmmGM4RXlN9J24R","left":108,"top":215},{"type":"resize_element","element_id":"PBq6H70nRkMfD5Xj-LBmmGM4RXlN9J24R","width":1680},{"type":"format_text","element_id":"PBq6H70nRkMfD5Xj-LBmmGM4RXlN9J24R","formatting":{"font_size":28,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBq6H70nRkMfD5Xj-LB2qSnggGsVC7CWK","text":"Manba: OSHA Computer Workstations · Ergonomik tavsiyalar"}]],[11,[{"type":"replace_text","element_id":"PBT1n3DyMd19GTBW-LBghqSWKv6HVN7c6","text":"Ruhiy qulaylikka yordam"},{"type":"position_element","element_id":"PBT1n3DyMd19GTBW-LBghqSWKv6HVN7c6","left":1010,"top":112},{"type":"resize_element","element_id":"PBT1n3DyMd19GTBW-LBghqSWKv6HVN7c6","width":780},{"type":"format_text","element_id":"PBT1n3DyMd19GTBW-LBghqSWKv6HVN7c6","formatting":{"font_size":54,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBT1n3DyMd19GTBW-LBqhn7DMvQYFP3C6","text":"Vazifani kichik bo‘laklarga ajratish, tanaffusni oldindan rejalash va bajarilgan vaqtni ko‘rish foydalanuvchining ish yukini boshqarishiga ko‘maklashishi mumkin.\nMahsulot yondashuvi muloyim: eslatmani kechiktirish, sessiyani to‘xtatish va kamerani o‘chirish foydalanuvchining o‘zida qoladi. Rejalashtirilayotgan jamoa modulida shaxslarni majburan reytinglash ko‘zda tutilmaydi.\nFocusSense ruhiy zo‘riqishni kamaytirishga yo‘naltirilgan odatlarni qo‘llab-quvvatlaydi. Bu ta’sir hali isbotlanmagan; pilotda foydalanuvchi fikri va subyektiv zo‘riqish ko‘rsatkichlari bilan baholanadi. Ilova psixologik tashxis qo‘ymaydi."},{"type":"position_element","element_id":"PBT1n3DyMd19GTBW-LBqhn7DMvQYFP3C6","left":1010,"top":295},{"type":"resize_element","element_id":"PBT1n3DyMd19GTBW-LBqhn7DMvQYFP3C6","width":790},{"type":"format_text","element_id":"PBT1n3DyMd19GTBW-LBqhn7DMvQYFP3C6","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}},{"type":"position_element","element_id":"PBT1n3DyMd19GTBW-LBnNcSqZQxJdnQcD","left":1010,"top":745},{"type":"resize_element","element_id":"PBT1n3DyMd19GTBW-LBnNcSqZQxJdnQcD","width":790,"height":66},{"type":"format_text","element_id":"PBT1n3DyMd19GTBW-LBnNcSqZQxJdnQcD","formatting":{"font_size":23,"font_weight":"bold","font_style":"normal"}},{"type":"position_element","element_id":"PBT1n3DyMd19GTBW-LBh5KtTQ0CD6Jnj8","left":1010,"top":833},{"type":"resize_element","element_id":"PBT1n3DyMd19GTBW-LBh5KtTQ0CD6Jnj8","width":790,"height":66},{"type":"format_text","element_id":"PBT1n3DyMd19GTBW-LBh5KtTQ0CD6Jnj8","formatting":{"font_size":23,"font_weight":"bold","font_style":"normal"}},{"type":"position_element","element_id":"PBT1n3DyMd19GTBW-LB0Yl9R3jwMLZ2MP","left":1010,"top":921},{"type":"resize_element","element_id":"PBT1n3DyMd19GTBW-LB0Yl9R3jwMLZ2MP","width":790,"height":66},{"type":"format_text","element_id":"PBT1n3DyMd19GTBW-LB0Yl9R3jwMLZ2MP","formatting":{"font_size":23,"font_weight":"bold","font_style":"normal"}}]],[12,[{"type":"replace_text","element_id":"PBLNVMdRhSJ3k9Jy-LB0WL38tB0h0xBk2","text":"Kamera kadrlari qurilmaning o‘zida qayta ishlanadi; video yozilmaydi va AI xizmatiga yuborilmaydi. Sessiya ko‘rsatkichlari foydalanuvchining qurilmasida saqlanadi.\nTashqi AI yoqilganda foydalanuvchi savoli va zarur umumiy sessiya ma’lumotlari xizmatga yuboriladi. Kamera tahlili bilan tashqi AI muloqoti alohida jarayonlardir.\nJamoalar uchun rejalashtirilgan hisobotlarda faqat rozilik asosida umumlashtirilgan ko‘rsatkichlardan foydalanish ko‘zda tutiladi. Ma’lumotni saqlash, o‘chirish va shifrlash tartibi tijorat bosqichidan oldin tekshiriladi."},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LB0WL38tB0h0xBk2","left":108,"top":215},{"type":"resize_element","element_id":"PBLNVMdRhSJ3k9Jy-LB0WL38tB0h0xBk2","width":1680},{"type":"format_text","element_id":"PBLNVMdRhSJ3k9Jy-LB0WL38tB0h0xBk2","formatting":{"font_size":29,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBLNVMdRhSJ3k9Jy-LBkdw9CnM9wqP8Vc","text":"QURILMADA"},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBbQwXTcvyfV4HyY","left":120,"top":490},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LB6MnNHyJKYV2lxn","left":680,"top":490},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBHzXzxwXbYq4sfb","left":1240,"top":490},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBMfHvgR7bdmPk8y","left":120,"top":785},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBrtjthLg7yMxkVh","left":680,"top":785},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBFH4dPgtp7ysYSx","left":1240,"top":785},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBkdw9CnM9wqP8Vc","left":120,"top":440},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBWDfGdjs2ZG2dgF","left":120,"top":735},{"type":"replace_text","element_id":"PBLNVMdRhSJ3k9Jy-LBL7BsFV2xfdFGXv","text":"Kamera videosi qurilmadan tashqariga yuborilmaydi."},{"type":"position_element","element_id":"PBLNVMdRhSJ3k9Jy-LBL7BsFV2xfdFGXv","left":120,"top":960},{"type":"resize_element","element_id":"PBLNVMdRhSJ3k9Jy-LBL7BsFV2xfdFGXv","width":1560},{"type":"format_text","element_id":"PBLNVMdRhSJ3k9Jy-LBL7BsFV2xfdFGXv","formatting":{"font_size":26,"font_weight":"normal","font_style":"normal"}}]],[13,[{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LB8f3YbX4tvDmg41","text":"Loyihaning yangiligi: birlashtirilgan shaxsiy yordam"},{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LBZwL3lhHxw7c2j5","text":"Bitta jarayon: fokus sessiyalari, tanaffuslar, AI tavsiyalari va kelajakdagi ergonomika yordami birlashadi."},{"type":"resize_element","element_id":"PBldMkSkFYH8zVGs-LBZwL3lhHxw7c2j5","width":1570},{"type":"format_text","element_id":"PBldMkSkFYH8zVGs-LBZwL3lhHxw7c2j5","formatting":{"font_size":34,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LBFwJJ1FV8t3NPSG","text":"Qurilmada tahlil: kamera kadrlari lokal qayta ishlanadi, bu maxfiylikka tayangan foydalanish imkonini beradi."},{"type":"resize_element","element_id":"PBldMkSkFYH8zVGs-LBFwJJ1FV8t3NPSG","width":1570},{"type":"format_text","element_id":"PBldMkSkFYH8zVGs-LBFwJJ1FV8t3NPSG","formatting":{"font_size":34,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LBStthtfr0tDVRzN","text":"Shaxsiy moslash: kalibrlash foydalanuvchining yoritishi, kamera burchagi va odatlarini hisobga olishga yo‘naltirilgan."},{"type":"resize_element","element_id":"PBldMkSkFYH8zVGs-LBStthtfr0tDVRzN","width":1570},{"type":"format_text","element_id":"PBldMkSkFYH8zVGs-LBStthtfr0tDVRzN","formatting":{"font_size":34,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LBmkL8PrqWKg19MS","text":"Mahalliy auditoriya: o‘zbekcha izohlar va tushunarli interfeys O‘zbekiston bozorida sinovdan o‘tkaziladi."},{"type":"resize_element","element_id":"PBldMkSkFYH8zVGs-LBmkL8PrqWKg19MS","width":1570},{"type":"format_text","element_id":"PBldMkSkFYH8zVGs-LBmkL8PrqWKg19MS","formatting":{"font_size":34,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBldMkSkFYH8zVGs-LBsH9lnzpN3RHbN7","text":"Farqlanish qiymati pilotda tekshiriladi. Loyiha o‘xshash vositalar mavjudligini inkor etmaydi."},{"type":"resize_element","element_id":"PBldMkSkFYH8zVGs-LBsH9lnzpN3RHbN7","width":1570},{"type":"format_text","element_id":"PBldMkSkFYH8zVGs-LBsH9lnzpN3RHbN7","formatting":{"font_size":34,"font_weight":"normal","font_style":"normal"}}]],[14,[{"type":"replace_text","element_id":"PBwPLkQhxMb4gdcT-LBSdwJzzYGDhqS0Z","text":"Dastur kamera oqimi, taymer, lokal saqlash va AI muloqotini alohida modullarga ajratadi. OpenCV hamda MediaPipe ko‘rinadigan belgilarni qurilmada tahlil qiladi; vaqt va holat natijalari sessiya tarixiga yoziladi."},{"type":"position_element","element_id":"PBwPLkQhxMb4gdcT-LBSdwJzzYGDhqS0Z","left":108,"top":230},{"type":"resize_element","element_id":"PBwPLkQhxMb4gdcT-LBSdwJzzYGDhqS0Z","width":1680},{"type":"format_text","element_id":"PBwPLkQhxMb4gdcT-LBSdwJzzYGDhqS0Z","formatting":{"font_size":32,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBwPLkQhxMb4gdcT-LBW3BbSsl0wX182b","text":"AI yordamchisi faqat foydalanuvchi uni tanlaganda tashqi xizmat bilan muloqot qiladi. Savol va zarur umumiy sessiya ko‘rsatkichlari yuborilishi mumkin; kamera videosi lokal moduldan tashqariga chiqmaydi. Natija foydalanuvchiga tavsiya va tushunarli xulosa sifatida qaytariladi."},{"type":"position_element","element_id":"PBwPLkQhxMb4gdcT-LBW3BbSsl0wX182b","left":108,"top":750},{"type":"resize_element","element_id":"PBwPLkQhxMb4gdcT-LBW3BbSsl0wX182b","width":1680},{"type":"format_text","element_id":"PBwPLkQhxMb4gdcT-LBW3BbSsl0wX182b","formatting":{"font_size":32,"font_weight":"normal","font_style":"normal"}}]],[15,[{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LBTtvsFZSxfgskFs","text":"Hozir nima tayyor, yana nimalar qo‘shiladi?"},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LBM3n7dWGmMsfT54","text":"Windows prototipi mavjud. Texnik tekshiruvlar dastur ishlashini baholaydi; inson diqqatiga foyda va pullik talab esa hali foydalanuvchilar bilan sinovdan o‘tkazilmagan."},{"type":"position_element","element_id":"PBkdXwGb0BSr31XV-LBM3n7dWGmMsfT54","left":108,"top":220},{"type":"resize_element","element_id":"PBkdXwGb0BSr31XV-LBM3n7dWGmMsfT54","width":1680},{"type":"format_text","element_id":"PBkdXwGb0BSr31XV-LBM3n7dWGmMsfT54","formatting":{"font_size":31,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LB09flZBmShLrXvY","text":"MAVJUD PROTOTIP"},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LB2Nd4dtl2zKFjNK","text":"TEXNIK TEKSHIRUV"},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LBr9XqmxtljPCRyM","text":"RIVOJLANISH REJASI"},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LB9QSpz8kdWsrTbq","text":"FocusLens nomidagi Windows prototipi: lokal kamera tahlili, fokus taymeri, sessiya statistikasi va ixtiyoriy AI yordamchisi."},{"type":"format_text","element_id":"PBkdXwGb0BSr31XV-LB9QSpz8kdWsrTbq","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LB1MY480cKVqgkv9","text":"Tekshiruv hisobotida 31 avtomatik test qayd etilgan. Haqiqiy kamera qurilmasi va jonli DeepSeek so‘rovi alohida tekshirilishi kerak."},{"type":"format_text","element_id":"PBkdXwGb0BSr31XV-LB1MY480cKVqgkv9","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBkdXwGb0BSr31XV-LB10kD6Rjt8MPDhn","text":"Ergonomika, telefonni ajratish, pullik tariflar, hisob-kitob va rozilik asosidagi jamoa hisobotlari keyingi bosqichda rivojlantiriladi."},{"type":"format_text","element_id":"PBkdXwGb0BSr31XV-LB10kD6Rjt8MPDhn","formatting":{"font_size":30,"font_weight":"normal","font_style":"normal"}}]],[16,[{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBlbfLncMG2Bc9Ww","text":"Olti oylik amalga oshirish rejasi"},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBPWZZB5hwfwGV3y","text":"Reja: mahsulotni yaxshilash, 4–5-oylarda olti haftalik pilotni o‘tkazish va tijorat modelini sinash. Maqsad — 500 faol foydalanuvchi hamda dastlabki pullik mijozlar; bu mavjud natija emas."},{"type":"position_element","element_id":"PBMZn74kqNvDHFQB-LBPWZZB5hwfwGV3y","left":108,"top":220},{"type":"resize_element","element_id":"PBMZn74kqNvDHFQB-LBPWZZB5hwfwGV3y","width":1680},{"type":"format_text","element_id":"PBMZn74kqNvDHFQB-LBPWZZB5hwfwGV3y","formatting":{"font_size":31,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBcqp8XlWKKtLyV1","text":"1–2-OYLAR"},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBYNKG0RyQsl2b52","text":"Kalibrlashni yaxshilash va ergonomika modulining dastlabki namunasini yaratish."},{"type":"format_text","element_id":"PBMZn74kqNvDHFQB-LBYNKG0RyQsl2b52","formatting":{"font_size":28,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBQ4FqKVGDbJg3Qw","text":"3–4-OYLAR"},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBTk631xnhcN8DMD","text":"Xavfsizlik, tarif va hisob-kitobni tayyorlash. 4-oyda pilotni boshlash."},{"type":"format_text","element_id":"PBMZn74kqNvDHFQB-LBTk631xnhcN8DMD","formatting":{"font_size":28,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBllvl0mDBp24ThF","text":"5-OY"},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBnBfbvbytSX6252","text":"Olti haftalik pilotni yakunlash. Noto‘g‘ri eslatmalar va foydalanuvchi fikri asosida tuzatish."},{"type":"format_text","element_id":"PBMZn74kqNvDHFQB-LBnBfbvbytSX6252","formatting":{"font_size":28,"font_weight":"normal","font_style":"normal"}},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LB9HgQ7M8nCzcw03","text":"6-OY"},{"type":"replace_text","element_id":"PBMZn74kqNvDHFQB-LBfgCrnKYzZ3Pc47","text":"Tijorat sinovi, xizmat xarajatlarini tekshirish va dastur ro‘yxatiga ariza tayyorlash."},{"type":"format_text","element_id":"PBMZn74kqNvDHFQB-LBfgCrnKYzZ3Pc47","formatting":{"font_size":28,"font_weight":"normal","font_style":"normal"}},{"type":"resize_element","element_id":"PBMZn74kqNvDHFQB-LBmHTRt1Hn3XSkjX","width":380,"height":350},{"type":"resize_element","element_id":"PBMZn74kqNvDHFQB-LBZhlQJWV42jqW59","width":380,"height":350},{"type":"resize_element","element_id":"PBMZn74kqNvDHFQB-LBktbvlfYKjs8h8k","width":380,"height":350},{"type":"resize_element","element_id":"PBMZn74kqNvDHFQB-LBJxBWxJmm8YKtnh","width":380,"height":350}]]]
